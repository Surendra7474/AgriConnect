# ============================================================
# AgriConnect Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ------ Database (MySQL / H2) ------
# For local development with H2 (no setup needed):
DB_URL=jdbc:h2:mem:agriconnect_db;DB_CLOSE_DELAY=-1;MODE=MySQL
DB_USERNAME=sa
DB_PASSWORD=
DB_DRIVER=org.h2.Driver
JPA_DDL_AUTO=create-drop

# For MySQL (uncomment and set below):
# DB_URL=jdbc:mysql://localhost:3306/agriconnect_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=your_mysql_password
# DB_DRIVER=com.mysql.cj.jdbc.Driver
# JPA_DDL_AUTO=update

# ------ JWT ------
JWT_SECRET=ChangeThisSecretToAStrongValueWithAtLeast32Characters
JWT_ACCESS_MINUTES=120
JWT_REFRESH_DAYS=14

# ------ CORS ------
FRONTEND_URL=http://localhost:5173

# ------ Admin Default Account ------
ADMIN_DEFAULT_EMAIL=admin@agriconnect.local
ADMIN_DEFAULT_PASSWORD=Admin@12345

# ------ Server ------
PORT=8080

# ------ Email (optional for password reset via email) ------
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-app-password
