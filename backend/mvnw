# Maven Wrapper Start Script
# This script wraps the Maven invocation, automatically downloading
# the Maven distribution and wrapper jar if not already present.

MAVEN_PROJECTBASEDIR=$( cd "$( dirname "$0" )" && pwd )

# Resolve links: $0 may be a symlink
if [ -L "$0" ]; then
  PRG=$( readlink "$0" 2>/dev/null || echo "$0" )
  MAVEN_PROJECTBASEDIR=$( cd "$( dirname "$PRG" )" && pwd )
fi

export MAVEN_PROJECTBASEDIR="${MAVEN_PROJECTBASEDIR}"

# Use the JVM configured in JAVA_HOME, falling back to java in PATH
if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
  JAVACMD="$JAVA_HOME/bin/java"
else
  JAVACMD="$( command -v java )"
fi

if [ ! -x "$JAVACMD" ]; then
  echo "ERROR: JAVA_HOME is not set and no 'java' command could be found in your PATH." >&2
  echo "Please set the JAVA_HOME variable in your environment to match the" >&2
  echo "location of your Java installation." >&2
  exit 1
fi

# Maven wrapper JAR location
WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"

# Download the wrapper JAR if missing
if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Downloading Maven Wrapper JAR..."
  WRAPPER_URL="https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.3.2/maven-wrapper-3.3.2.jar"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$WRAPPER_URL" -o "$WRAPPER_JAR"
  elif command -v wget >/dev/null 2>&1; then
    wget -q "$WRAPPER_URL" -O "$WRAPPER_JAR"
  else
    echo "ERROR: curl or wget is required to download the Maven wrapper." >&2
    exit 1
  fi
  if [ ! -f "$WRAPPER_JAR" ]; then
    echo "ERROR: Failed to download Maven Wrapper JAR." >&2
    exit 1
  fi
fi

# Maven distribution URL (from .mvn/wrapper/maven-wrapper.properties)
# distributionUrl=https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.9/apache-maven-3.9.9-bin.zip
MAVEN_OPTS="${MAVEN_OPTS} -Xmx1024m"

# Execute the Maven wrapper
exec "$JAVACMD" \
  $MAVEN_OPTS \
  -classpath "$WRAPPER_JAR" \
  "-Dmaven.multiModuleProjectDirectory=$MAVEN_PROJECTBASEDIR" \
  org.apache.maven.wrapper.MavenWrapperMain \
  "$@"
