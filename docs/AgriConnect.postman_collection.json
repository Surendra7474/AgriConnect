              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Farmer\",\n  \"email\": \"farmer@agriconnect.local\",\n  \"password\": \"Farmer@123\",\n  \"phone\": \"+15551234567\",\n  \"role\": \"FARMER\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
