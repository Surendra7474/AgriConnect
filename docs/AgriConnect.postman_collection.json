              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Mike Worker\",\n  \"email\": \"worker@agriconnect.local\",\n  \"password\": \"Worker@123\",\n  \"phone\": \"+15555555555\",\n  \"role\": \"WORKER\"\n}"
